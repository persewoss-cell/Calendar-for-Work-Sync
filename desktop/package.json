{
  "name": "workcal-desktop",
  "productName": "업무 캘린더",
  "version": "1.0.0",
  "description": "바탕화면 업무 캘린더 (PC ↔ 모바일 동기화)",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.workcal.desktop",
    "productName": "업무 캘린더",
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "업무 캘린더"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "artifactName": "WorkCal-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "persewoss-cell",
        "repo": "Calendar-for-Work-Sync",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
