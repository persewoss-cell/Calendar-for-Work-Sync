# MongoDB Atlas 연결 문자열 (Atlas > Connect > Drivers 에서 복사, 끝에 /workcal 추가)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/workcal

# 아무 긴 임의 문자열 (로그인 유지 토큰 서명에 사용)
JWT_SECRET=change-me-to-a-long-random-string

# 서버가 외부에서 보이는 주소 (끝에 / 없이). https 이면 로그인 쿠키가 보안 모드로 설정됩니다.
PUBLIC_URL=https://my-calendar.onrender.com

# 회원가입 허용. 쓸 사람이 모두 가입한 뒤 false 로 바꾸면 더는 아무도 가입할 수 없습니다.
ALLOW_SIGNUP=true
