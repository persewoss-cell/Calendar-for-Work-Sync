# MongoDB Atlas 연결 문자열 (Atlas > Connect > Drivers 에서 복사)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/workcal?retryWrites=true&w=majority

# 아무 긴 임의 문자열 (로그인 토큰 서명 + 구글 토큰 암호화에 사용)
JWT_SECRET=change-me-to-a-long-random-string

# 서버가 외부에서 보이는 주소 (끝에 / 없이). 구글 OAuth 리디렉션 URI 가 PUBLIC_URL/auth/google/callback 이 됩니다.
PUBLIC_URL=https://my-calendar.onrender.com

# 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 구글 캘린더 자동 동기화 간격(분)
SYNC_INTERVAL_MIN=3

# 로컬 개발용: 구글 없이 로그인 버튼을 보여줌 (운영에서는 끄세요)
DEV_LOGIN=false
# 로컬 개발 시 Vite 개발 서버 주소 (로그인 후 돌아갈 곳)
# WEB_URL=http://localhost:5173
